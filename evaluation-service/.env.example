# evaluation-service reads all secrets from server/.env via explicit load_dotenv path.
# No separate .env needed in this directory for local development.
# For standalone deployment (Step 10 stretch), copy the vars below from server/.env:
#
# OPENAI_API_KEY=
# DATABASE_URL=
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=
# LANGCHAIN_TRACING_V2=
